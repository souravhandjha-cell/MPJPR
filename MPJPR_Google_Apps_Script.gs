function doGet(e){var id=(e.parameter.id||"").trim().toLowerCase(),email=(e.parameter.email||"").trim().toLowerCase();var sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Manuscripts");if(!sh)return out({found:false});var v=sh.getDataRange().getDisplayValues();for(var i=1;i<v.length;i++){if((v[i][0]||"").trim().toLowerCase()==id&&(v[i][1]||"").trim().toLowerCase()==email)return out({found:true,id:v[i][0],title:v[i][2],status:v[i][3],submitted:v[i][4],updated:v[i][5],message:v[i][6]});}return out({found:false});}function out(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}